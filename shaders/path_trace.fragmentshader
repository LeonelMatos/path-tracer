#version 330 core

in vec2 vUv;
out vec4 frag_color;

uniform vec2 resolution;
uniform int frame_id;
uniform sampler2D prev_frame;

const float PI = 3.14159;
const float INF = 1e30;
const float EPS = 0.001;
const float LOW = 1e-8;
const int DEPTH = 5;

const vec3 camera_position = vec3(0.0, -5.0, 0.0);
const vec3 camera_lookat = vec3(0.0, 0.0, 0.0);
const vec3 camera_up = vec3(0.0, 0.0, 1.0);

const vec3 WHITE = vec3(0.90, 0.90, 0.90);
const vec3 RED   = vec3(0.90, 0.05, 0.05);
const vec3 GREEN = vec3(0.05, 0.90, 0.05);


//Adaptado de https://www.scribd.com/document/582697876/Jarzynski2020Hash
vec3 pcg3d(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y*v.z; v.y += v.z*v.x; v.z += v.x*v.y;
    v ^= v >> 16u;
    v.x += v.y*v.z; v.y += v.z*v.x; v.z += v.x*v.y;
    return vec3(v) * (1.0 / float(0xFFFFFFFFu));
}

vec3 rand3(int bounce) {
    uvec2 px = uvec2(gl_FragCoord.xy);
    uint fid = uint(frame_id);
    return pcg3d(uvec3(
        px.x ^ (fid * 2654435761u), //TODO why fixed nums
        px.y ^ (fid * 2246822519u),
        uint(bounce + 1)
    ));
}

mat3 onb(vec3 n) {
    vec3 up = abs(n.x) > 0.9 ? vec3(0,1,0) : vec3(1,0,0);
    vec3 t = normalize(cross(up, n));
    return mat3(t, cross(n, t), n);
}

vec3 cameraRay(vec3 uv) {
    float aspect = resolution.x / resolution.y;
    float f_len = 1.0 / tan(0.5 * 30.0 * PI / 180.0);
    vec2 p = 2.0 * uv - 1.0;
    vec3 ray_cam = vec3(p.x * aspect, p.y, -f_len);

    vec3 cam_z = normalize(camera_position - camera_lookat);
    vec3 cam_x = normalize(cross(camera_up, cam-cam_z));
    vec3 cam_y = cross(cam_z, cam_x);

    return normalize(cam_x * ray_cam.x + cam_y * ray_cam.y + cam_z * ray_cam.z);
}

//Ray struct

struct Hit { float t; vec3 pos, normal, albedo, emission; };

float sphereT(vec3 ro, vec3 rd, vec3 c, float r) {
    vec3 oc = ro - c;
    float b = dot(oc, rd);
    float disc = b*b - dot(oc, oc) + r*r;
    if (disc < 0.0) return INF;
    float sq = sqrt(disc);

    float t = -b - sq;
    if (t > EPS) return t;
    
    t = -b + sq;
    return (t > EPS) ? t : INF;
}

bool intersects(vec3 ro, vec3 rd, out Hit h) {
    h.t = INF;
    h.pos = vec3(0);
    h.normal = vec3(0,0,1);
    h.albedo = WHITE;
    h.emission = vec3(0);

    //Ambiente

    //Chão (z = -1) Teto (z = +1)
    if (abs(rd.z) > 1e-8) {
        t = (-1.0 - ro.z) / rd.z;
        if (t > EPS && t < h.t) { p = ro+t*rd;
            if (abs(p.x)<=1.0 && p.y>=-1.0 && p.y<=1.0)
                {
                    h.t=t;
                    h.pos=p;
                    h.normal=vec3(0,0,1);
                    h.albedo=WHITE;
                    h.emission=vec3(0); 
                } 
            }
        t = (1.0 - ro.z) / rd.z;
        if (t > EPS && t < h.t) {
            p = ro+t*rd;
            if (abs(p.x)<=1.0 && p.y>=-1.0 && p.y<=1.0)
                { h.t=t; h.pos=p; h.normal=vec3(0,0,-1); h.albedo=WHITE; h.emission=vec3(0); } }
    }
    //Parece de fundo (y=1)
    if (abs(rd.y) > 1e-8) {
        t = (1.0 - ro.y) / rd.y;
        if (t > EPS && t < h.t) {
            p = ro+t*rd;
            if (abs(p.x)<=1.0 && p.z>=-1.0 && p.z<=1.0) {
                h.t=t;
                h.pos=p;
                h.normal=vec3(0,-1,0);
                h.albedo=WHITE;
                h.emission=vec3(0);
            } 
        }
    }

    // Esfera de luz
    t = sphereT(ro, rd, vec3(0.0, 0.0, 0.78), 0.035);
    if (t < h.t) {
         h.t=t; h.pos=ro+t*rd;
        h.normal=normalize(h.pos-vec3(0,0,0.78));
        h.albedo=vec3(0); h.emission=vec3(15.0); 
    }

    return h.t < INF;
}